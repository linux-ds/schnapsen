#: src/ui/turn.rs:388
#, rust-format
msgid "Wait for the current turn to finish."
msgstr "Warte, bis der laufende Zug abgeschlossen ist."

#: src/ui/turn.rs:397
#, rust-format
msgid "Tricks stay face down in Sharp Schnapsen."
msgstr "Bei scharfem Schnapsen bleiben die Stiche verdeckt."

#: src/ui/turn.rs:399
#, rust-format
msgid "This pile has no tricks yet."
msgstr "Dieser Stapel enthält noch keine Stiche."

