msgstr "Oben: {opponent_points}, {opponent_bummerls}. {hands}. Unten: {local_points}, {local_bummerls}. Trumpf: {suit}."

#: src/ui/turn.rs:522
#, rust-format
msgid "Exchange trump · Press T or tap the face-up card"
msgstr "Trumpf tauschen · T oder offene Karte antippen"

#: src/ui/turn.rs:524
#, rust-format
msgid "Close the stock · Press Z or tap the face-down pile"
msgstr "Talon zudrehen · Z oder verdeckten Stapel antippen"

#: src/ui/turn.rs:581
#, rust-format
msgid "{count} point remaining"
msgid_plural "{count} points remaining"
msgstr[0] "{count} Restpunkt"
msgstr[1] "{count} Restpunkte"

#: src/ui/turn.rs:591
#, rust-format
msgid "You need a face-up trump card to exchange."
msgstr "Zum Tauschen brauchst du eine offene Trumpfkarte."

#: src/ui/turn.rs:593
#, rust-format
msgid "Exchange the trump card before leading to the trick."
msgstr "Du kannst nur vor dem Ausspiel tauschen."

#: src/ui/turn.rs:595
#, rust-format
msgid "You can exchange the trump card only when it is your lead."
msgstr "Du kannst nur mit Ausspielrecht tauschen."

#: src/ui/turn.rs:599 src/ui/turn.rs:669
#, rust-format
msgid "Select the trump {rank}."
msgstr "Wähle den Trumpf-{rank} aus."

#: src/ui/turn.rs:603 src/ui/turn.rs:612
#, rust-format
msgid "Available after the first trick."
msgstr "Erst nach dem ersten Stich möglich."

#: src/ui/turn.rs:604 src/ui/turn.rs:614
#, rust-format
msgid "Too few cards in the stock."
msgstr "Zu wenige Karten im Talon."

#: src/ui/turn.rs:610
#, rust-format
msgid "The stock must be open."
msgstr "Der Talon muss offen sein."

#: src/ui/turn.rs:611
#, rust-format
msgid "Close the stock before leading to the trick."
msgstr "Du kannst nur vor dem Ausspiel zudrehen."

#: src/ui/turn.rs:613
#, rust-format
msgid "You can close the stock only when it is your lead."
msgstr "Du kannst nur mit Ausspielrecht zudrehen."

#: src/ui/turn.rs:621
#, rust-format
msgid "You must play a higher card of the same suit ({suit})."
msgstr "Du musst mit einer höheren {suit}-Karte stechen."

#: src/ui/turn.rs:625 src/ui/turn.rs:661 src/ui/turn.rs:665
#, rust-format
msgid "You must follow suit: {suit}."
msgstr "Du musst {suit} bedienen."

#: src/ui/turn.rs:628
#, rust-format
msgid "You must play a trump card."
msgstr "Du musst Trumpf spielen."

#: src/ui/turn.rs:629
#, rust-format
msgid "It is not your turn yet."
msgstr "Du bist noch nicht am Zug."

#: src/ui/turn.rs:630
#, rust-format
msgid "The current trick is still being resolved."
msgstr "Der Stich wird noch aufgelöst."

#: src/ui/turn.rs:631
#, rust-format
msgid "This card is no longer in your hand."
msgstr "Diese Karte ist nicht mehr auf deiner Hand."

#: src/ui/turn.rs:632
#, rust-format
msgid "The hand is already over."
msgstr "Die Hand ist bereits beendet."
