<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>org.linuxds.Schnapsen</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Schnapsen</name>
  <summary>A card game for GNOME</summary>
  <description>
    <p>Schnapsen is a native GNOME application for the Austrian card game. Play a hand against the computer and win by reaching 66 card points or taking the last trick.</p>
  </description>
  <developer id="org.linuxds">
    <name>Linux DS Team</name>
  </developer>
  <url type="homepage">https://linux-ds.org/</url>
  <url type="vcs-browser">https://github.com/linux-ds/schnapsen</url>
  <url type="bugtracker">https://github.com/linux-ds/schnapsen/issues</url>
  <translation type="gettext">schnapsen</translation>
  <launchable type="desktop-id">org.linuxds.Schnapsen.desktop</launchable>
  <releases>
    <release version="0.5.1" date="2026-11-28">
      <description>
        <p>Updates the Flatpak to GNOME Platform 50 and verifies the AppStream catalog and icons during export.</p>
      </description>
    </release>
    <release version="0.5.0" date="2026-11-27">
      <description>
        <p>Introduces the new Double German card design as the default and adds an About dialog.</p>
      </description>
    </release>
  </releases>
  <content_rating type="oars-1.1"/>
</component>
